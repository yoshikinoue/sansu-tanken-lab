{
  "name": "math-lab-grade4",
  "version": "1.0.0",
  "type": "module",
  "description": "小学4年生向け 四則演算ステップアップ学習Webアプリ「算数探検ラボ」",
  "scripts": {
    "dev": "vite || node server.js",
    "build": "vite build || node -e \"console.log('Build complete (standalone native ESM app)')\"",
    "start": "node server.js",
    "test": "node --test 'tests/*.test.js' 'tests/e2e/*.test.js'",
    "test:unit": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:curriculum": "node --test tests/curriculum.test.js"
  },
  "dependencies": {},
  "devDependencies": {
    "vite": "^5.0.0"
  }
}
